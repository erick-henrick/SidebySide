FROM golang:1.25-trixie AS neko-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libx11-dev libxrandr-dev libxtst-dev libgtk-3-dev libxcvt-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

ADD https://codeload.github.com/m1k1o/neko/tar.gz/395ca1a6f62b7b0e270e654d366a2d57b8042efd /tmp/neko.tar.gz
WORKDIR /src
RUN tar -xzf /tmp/neko.tar.gz --strip-components=1

# Mantém o cliente do Neko 3.1.5 e corrige os candidatos TURN por TCP/TLS.
WORKDIR /src/server
RUN go get github.com/pion/ice/v4@v4.2.4 \
    && GIT_COMMIT=395ca1a GIT_TAG=v3.1.5 ./build core

FROM ghcr.io/m1k1o/neko/chromium:3.1.5 AS browser
COPY --from=neko-build /src/server/bin/neko /usr/bin/neko
COPY browser/inspect-browser.py browser/control-server.py /opt/cinema/
COPY browser/neko-policy.json /etc/chromium/policies/managed/policies.json
RUN sed -i 's#command=/usr/bin/chromium#command=/usr/bin/chromium --remote-debugging-port=9222#' /etc/neko/supervisord/chromium.conf
COPY browser/cinema-control.conf /etc/neko/supervisord/cinema-control.conf

FROM browser AS browser-hls
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY browser/start-live.sh /opt/cinema/start-live.sh
COPY browser/cinema-live.conf /etc/neko/supervisord/cinema-live.conf

FROM browser-hls AS browser-lab
RUN apt-get update && apt-get install -y --no-install-recommends x11vnc novnc websockify \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/autostart=true/autostart=false/' /etc/neko/supervisord/cinema-live.conf
COPY browser/start-chromium-lab.sh /opt/cinema/start-chromium-lab.sh
COPY browser/cinema-lab.conf /etc/neko/supervisord/cinema-lab.conf

FROM browser AS production
